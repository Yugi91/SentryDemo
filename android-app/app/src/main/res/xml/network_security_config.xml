<?xml version="1.0" encoding="utf-8"?>
<!--
  Allow cleartext HTTP only for local Sentry self-hosted setups. Production
  builds shipping to real devices should serve Sentry over HTTPS and remove
  these exceptions.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>      <!-- AVD host loopback -->
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">192.168.1.0</domain>
    </domain-config>
</network-security-config>
