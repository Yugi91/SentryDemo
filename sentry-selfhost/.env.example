# Copy to .env and tweak. Values here are appended onto the upstream .env
# that install.sh manages, so they win on conflict.

# Host:port that Sentry's web UI binds to on the docker host
SENTRY_BIND=9000

# Set to a strong random string; install.sh will keep it stable across re-runs
# SENTRY_SECRET_KEY=

# Retention in days (events older than this are pruned)
SENTRY_EVENT_RETENTION_DAYS=30

# Email — leave defaults for local demo, set real SMTP for prod-like setups
# SENTRY_EMAIL_HOST=smtp.gmail.com
# SENTRY_EMAIL_PORT=587
# SENTRY_EMAIL_USER=
# SENTRY_EMAIL_PASSWORD=
# SENTRY_EMAIL_USE_TLS=true
